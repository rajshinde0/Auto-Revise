# Copy this file to .env and fill in your own values.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
#
# .env is gitignored. Never commit real credentials - put placeholders here.

# Flask Configuration
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
# Use "development" only for local work; it enables the Werkzeug debugger.
FLASK_ENV=production

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=mcq_flashcards
DB_POOL_SIZE=32

# Session Configuration
SESSION_LIFETIME_DAYS=7
# Set to True when serving over HTTPS so session cookies are not sent in clear.
SESSION_COOKIE_SECURE=False

# Security Configuration
CSRF_ENABLED=True

# Rate Limiting (failed logins are counted per username + IP)
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_ATTEMPTS_WINDOW_MINUTES=15

# Quiz / leaderboard sizing
QUIZ_QUESTION_COUNT=20
LEADERBOARD_SIZE=50

# Maximum accepted upload size for CSV imports, in megabytes
MAX_UPLOAD_MB=5
